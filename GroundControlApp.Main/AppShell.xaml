<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GroundControlApp.Main.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GroundControlApp.Main"
    xmlns:views="clr-namespace:GroundControlApp.Main.Views"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="GroundControlApp.Main">

    <ShellContent
        x:Name="LoadingShellContent"
        Title="Loading"
        ContentTemplate="{DataTemplate views:LoadingPage}"
        Route="LoadingPage" />

    <ShellContent
        x:Name="MainShellContent"
        Title="Point of Sale"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
