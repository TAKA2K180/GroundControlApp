<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GroundControlApp.Main.Views"
             x:Class="GroundControlApp.Main.MainPage"
             x:Name="RootPage"
             BackgroundColor="#F4F6F8">

    <Grid>
    <ScrollView>
        <Grid x:Name="RootGrid"
              Padding="18"
              ColumnSpacing="14"
              RowSpacing="14"
              RowDefinitions="Auto,*"
              ColumnDefinitions="1.45*,1*,360">

            <Border x:Name="HeaderPanel"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Padding="16"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DDE3EA"
                    StrokeShape="RoundRectangle 8">
                <Grid x:Name="HeaderGrid"
                      ColumnSpacing="12"
                      RowSpacing="10"
                      ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Ground Control"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="#14213D"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding ShiftStatus}"
                               FontSize="12"
                               TextColor="#667085" />
                    </VerticalStackLayout>

                    <FlexLayout x:Name="StatusBar"
                                Grid.Column="1"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="Center"
                                AlignContent="Center"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                        <Border Margin="4" Padding="10,6" BackgroundColor="#F4F6F8" Stroke="#DDE3EA" StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding CurrentTimeDisplay}" FontSize="12" TextColor="#14213D" />
                        </Border>
                        <Border Margin="4" Padding="10,6" BackgroundColor="#F4F6F8" Stroke="#DDE3EA" StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding UserStatusDisplay}" FontSize="12" TextColor="#14213D" />
                        </Border>
                        <Border Margin="4" Padding="10,6" BackgroundColor="#EEF4FF" Stroke="#C7D7FE" StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding RoleStatusDisplay}" FontSize="12" TextColor="#175CD3" />
                        </Border>
                        <Border Margin="4" Padding="10,6" BackgroundColor="#EAF8F0" Stroke="#ABEFC6" StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding ShiftSummaryDisplay}" FontSize="12" TextColor="#087443" />
                        </Border>
                        <Border Margin="4" Padding="10,6" BackgroundColor="#FFF6E5" Stroke="#FEDF89" StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding TicketStatusDisplay}" FontSize="12" TextColor="#B54708" />
                        </Border>
                        <Border Margin="4" Padding="10,6" BackgroundColor="#F4F6F8" Stroke="#DDE3EA" StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding OrderStatusDisplay}" FontSize="12" TextColor="#344054" />
                        </Border>
                    </FlexLayout>

                    <HorizontalStackLayout x:Name="HeaderActions"
                                           Grid.Column="2"
                                           Spacing="8"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center">
                        <Button Text="{Binding SignInButtonText}"
                                Command="{Binding ShowSignInCommand}"
                                IsVisible="{Binding IsGuestVisible}"
                                BackgroundColor="#F4F6F8"
                                TextColor="#344054"
                                CornerRadius="8" />
                        <Button Text="Home"
                                Command="{Binding OpenHomeCommand}"
                                BackgroundColor="#F4F6F8"
                                TextColor="#344054"
                                CornerRadius="8" />
                        <Button Text="Admin"
                                Command="{Binding OpenAdminCommand}"
                                IsVisible="{Binding IsAdminVisible}"
                                BackgroundColor="#EEF4FF"
                                TextColor="#175CD3"
                                CornerRadius="8" />
                        <Button Text="Logout"
                                Command="{Binding LogoutCommand}"
                                IsVisible="{Binding IsAdminVisible}"
                                BackgroundColor="#FEE4E2"
                                TextColor="#B42318"
                                CornerRadius="8" />
                        <Button Text="Sync"
                                Command="{Binding SyncCommand}"
                                BackgroundColor="#EEF4FF"
                                TextColor="#175CD3"
                                CornerRadius="8" />
                        <Button Text="{Binding OpenShiftText}"
                                Command="{Binding OpenShiftCommand}"
                                BackgroundColor="#14213D"
                                TextColor="#FFFFFF"
                                CornerRadius="8" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <Border x:Name="ProductPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="16"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DDE3EA"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Catalog"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="#14213D" />
                            <Label Text="{Binding SyncStatus}"
                                   FontSize="12"
                                   TextColor="#667085" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Scan"
                                Command="{Binding ScanCatalogCommand}"
                                BackgroundColor="#EAF8F0"
                                TextColor="#087443"
                                CornerRadius="8"
                                VerticalOptions="Center" />
                    </Grid>

                    <Border x:Name="SearchBox"
                            Padding="12,0"
                            BackgroundColor="#F4F6F8"
                            Stroke="#DDE3EA"
                            StrokeShape="RoundRectangle 8"
                            HeightRequest="46">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="Search"
                                   TextColor="#667085"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding SearchText}"
                                   Placeholder="menu item or category"
                                   PlaceholderColor="#98A2B3"
                                   TextColor="#111827"
                                   BackgroundColor="Transparent"
                                   ClearButtonVisibility="WhileEditing"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <CollectionView ItemsSource="{Binding Categories}"
                                    SelectionMode="None"
                                    HeightRequest="48">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Name}"
                                        Command="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{Binding BackgroundColor}"
                                        TextColor="{Binding TextColor}"
                                        CornerRadius="8" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <CollectionView x:Name="ProductList"
                                    ItemsSource="{Binding Products}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout x:Name="ProductItemsLayout"
                                             Orientation="Vertical"
                                             Span="3"
                                             HorizontalItemSpacing="10"
                                             VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PosTileStyle}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.AddProductCommand, Source={x:Reference RootPage}}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="*,Auto,Auto,Auto">
                                        <Label Text="{Binding Name}" Style="{StaticResource PosProductNameStyle}" />
                                        <Label Grid.Row="1" Text="{Binding Category}" Style="{StaticResource PosMetaStyle}" />
                                        <Label Grid.Row="2" Text="{Binding StockDisplay}" Style="{StaticResource PosMetaStyle}" />
                                        <Label Grid.Row="3" Text="{Binding DisplayPrice}" Style="{StaticResource PosPriceStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CartPanel"
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="16"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DDE3EA"
                    StrokeShape="RoundRectangle 8">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Current Ticket"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="#14213D" />
                            <Label Text="{Binding TicketStatus}"
                                   FontSize="12"
                                   TextColor="#667085" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Hold"
                                Command="{Binding HoldTicketCommand}"
                                BackgroundColor="#FFF6E5"
                                TextColor="#B54708"
                                CornerRadius="8" />
                    </Grid>

                    <CollectionView x:Name="CartList"
                                    Grid.Row="1"
                                    ItemsSource="{Binding CartItems}"
                                    SelectionMode="None"
                                    VerticalOptions="Start">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource PosLineItemStyle}"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" Style="{StaticResource PosLineNameStyle}" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource PosMetaStyle}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                            <Label Text="{Binding TotalDisplay}" Style="{StaticResource PosLineAmountStyle}" />
                                            <Label Text="{Binding DiscountDisplay}"
                                                   HorizontalTextAlignment="End"
                                                   Style="{StaticResource PosMetaStyle}" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <Button Text="-"
                                                    Command="{Binding BindingContext.DecreaseQuantityCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource PosTinyButtonStyle}" />
                                            <Button Text="+"
                                                    Command="{Binding BindingContext.IncreaseQuantityCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource PosTinyButtonStyle}" />
                                            <Button Text="X"
                                                    Command="{Binding BindingContext.RemoveCartItemCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE4E2"
                                                    TextColor="#B42318"
                                                    Style="{StaticResource PosTinyButtonStyle}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <CollectionView Grid.Row="1"
                                                    ItemsSource="{Binding AddOns}"
                                                    SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding Name}" Style="{StaticResource PosMetaStyle}" />
                                                    <Label Grid.Column="1" Text="{Binding PriceDisplay}" Style="{StaticResource PosMetaStyle}" />
                                                    <Button Grid.Column="2"
                                                            Text="X"
                                                            Command="{Binding BindingContext.RemoveCartItemAddOnCommand, Source={x:Reference RootPage}}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="#FEE4E2"
                                                            TextColor="#B42318"
                                                            Style="{StaticResource PosTinyButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Text="Add add-on"
                                                Command="{Binding BindingContext.ShowCartItemAddOnPickerCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#EAF8F0"
                                                TextColor="#087443"
                                                Style="{StaticResource PosSmallButtonStyle}" />
                                        <Button Grid.Column="1"
                                                Text="Discount"
                                                Command="{Binding BindingContext.ApplyLineDiscountCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFF6E5"
                                                TextColor="#B54708"
                                                Style="{StaticResource PosSmallButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout Grid.Row="3" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Subtotal" Style="{StaticResource PosMetaStyle}" />
                            <Label Grid.Column="1" Text="{Binding SubtotalDisplay}" Style="{StaticResource PosLineAmountStyle}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Line discounts" Style="{StaticResource PosMetaStyle}" />
                            <Label Grid.Column="1" Text="{Binding LineDiscountDisplay}" Style="{StaticResource PosMetaStyle}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Order discount" Style="{StaticResource PosMetaStyle}" />
                            <Label Grid.Column="1" Text="{Binding OrderDiscountDisplay}" Style="{StaticResource PosMetaStyle}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#E4E7EC" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="#14213D" />
                            <Label Grid.Column="1"
                                   Text="{Binding TotalDisplay}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22"
                                   TextColor="#087443" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid x:Name="PaymentPanel"
                  Grid.Row="1"
                  Grid.Column="2"
                  RowDefinitions="360,Auto"
                  RowSpacing="18">
                <Border Padding="16"
                        BackgroundColor="#14213D"
                        Stroke="#14213D"
                        StrokeShape="RoundRectangle 8">
                    <Grid RowDefinitions="Auto,*" RowSpacing="14">
                        <VerticalStackLayout Grid.Row="0" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Orders"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18"
                                           TextColor="#FFFFFF" />
                                    <Label Text="{Binding ShiftTransactionDisplay}"
                                           FontSize="12"
                                           TextColor="#C7D7FE" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        Padding="12,4"
                                        BackgroundColor="#FFFFFF"
                                        Stroke="#FFFFFF"
                                        StrokeShape="RoundRectangle 8"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding CompletedTransactionCount}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18"
                                           TextColor="#14213D" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Text="{Binding PendingOrderTabText}"
                                        Command="{Binding SelectOrderTabCommand}"
                                        CommandParameter="Pending"
                                        BackgroundColor="{Binding PendingOrderTabBackgroundColor}"
                                        TextColor="{Binding PendingOrderTabTextColor}"
                                        FontSize="12"
                                        Padding="6,10"
                                        CornerRadius="8" />
                                <Button Grid.Column="1"
                                        Text="{Binding InProgressOrderTabText}"
                                        Command="{Binding SelectOrderTabCommand}"
                                        CommandParameter="In progress"
                                        BackgroundColor="{Binding InProgressOrderTabBackgroundColor}"
                                        TextColor="{Binding InProgressOrderTabTextColor}"
                                        FontSize="12"
                                        Padding="6,10"
                                        CornerRadius="8" />
                                <Button Grid.Column="2"
                                        Text="{Binding CompletedOrderTabText}"
                                        Command="{Binding SelectOrderTabCommand}"
                                        CommandParameter="Completed"
                                        BackgroundColor="{Binding CompletedOrderTabBackgroundColor}"
                                        TextColor="{Binding CompletedOrderTabTextColor}"
                                        FontSize="12"
                                        Padding="6,10"
                                        CornerRadius="8" />
                            </Grid>
                        </VerticalStackLayout>

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding DisplayedOrders}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="0,28" Spacing="4">
                                    <Label Text="No pending orders"
                                           HorizontalTextAlignment="Center"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="#FFFFFF" />
                                    <Label Text="Charged tickets will appear here."
                                           HorizontalTextAlignment="Center"
                                           FontSize="12"
                                           TextColor="#C7D7FE" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="10"
                                            BackgroundColor="#243B64"
                                            Stroke="#35527F"
                                            StrokeShape="RoundRectangle 8">
                                        <Grid RowDefinitions="Auto,Auto,Auto"
                                              ColumnDefinitions="*,Auto"
                                              RowSpacing="6"
                                              ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding InvoiceNumber}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="#FFFFFF" />
                                                <Label Text="{Binding CustomerName}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="#FFFFFF" />
                                                <Label Text="{Binding ItemsSummary}"
                                                       FontSize="12"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="#C7D7FE" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding TotalDisplay}"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="#FFFFFF" />
                                            <Label Grid.Row="1"
                                                   Text="{Binding Status}"
                                                   FontSize="12"
                                                   TextColor="#C7D7FE" />
                                            <Button Grid.Row="2"
                                                    Grid.ColumnSpan="2"
                                                    Text="Order Finished"
                                                    Command="{Binding BindingContext.FinishOrderCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding CanFinish}"
                                                    BackgroundColor="#12B76A"
                                                    TextColor="#FFFFFF"
                                                    CornerRadius="8" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="16"
                        BackgroundColor="#14213D"
                        Stroke="#35527F"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Checkout"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="#FFFFFF" />
                            <Label Text="Customer details, split payment, and change."
                                   FontSize="12"
                                   TextColor="#C7D7FE" />
                        </VerticalStackLayout>

                        <Entry Text="{Binding CustomerName}"
                               Placeholder="Customer name"
                               PlaceholderColor="#C7D7FE"
                               TextColor="#FFFFFF"
                               BackgroundColor="#243B64"
                               HeightRequest="44" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Entry Text="{Binding CustomerPhone}"
                                   Placeholder="Customer number"
                                   PlaceholderColor="#C7D7FE"
                                   TextColor="#FFFFFF"
                                   BackgroundColor="#243B64"
                                   HeightRequest="44" />
                            <Entry Grid.Column="1"
                                   Text="{Binding CustomerAddress}"
                                   Placeholder="Customer address"
                                   PlaceholderColor="#C7D7FE"
                                   TextColor="#FFFFFF"
                                   BackgroundColor="#243B64"
                                   HeightRequest="44" />
                        </Grid>
                        <Editor Text="{Binding OrderNotes}"
                                Placeholder="Notes"
                                PlaceholderColor="#C7D7FE"
                                TextColor="#FFFFFF"
                                BackgroundColor="#243B64"
                                HeightRequest="60" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="10">
                            <Entry Text="{Binding CashAmountText}"
                                   Placeholder="Cash amount"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#C7D7FE"
                                   TextColor="#FFFFFF"
                                   BackgroundColor="#243B64"
                                   HeightRequest="44" />
                            <Entry Grid.Column="1"
                                   Text="{Binding CardAmountText}"
                                   Placeholder="Card amount"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#C7D7FE"
                                   TextColor="#FFFFFF"
                                   BackgroundColor="#243B64"
                                   HeightRequest="44" />
                            <Entry Grid.Row="1"
                                   Text="{Binding GCashAmountText}"
                                   Placeholder="GCash amount"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#C7D7FE"
                                   TextColor="#FFFFFF"
                                   BackgroundColor="#243B64"
                                   HeightRequest="44" />
                            <Entry Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding OtherAmountText}"
                                   Placeholder="Other amount"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#C7D7FE"
                                   TextColor="#FFFFFF"
                                   BackgroundColor="#243B64"
                                   HeightRequest="44" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="4">
                            <Label Text="Tendered"
                                   FontSize="12"
                                   TextColor="#C7D7FE" />
                            <Label Grid.Column="1"
                                   Text="{Binding TenderedTotalDisplay}"
                                   FontSize="12"
                                   TextColor="#FFFFFF" />
                            <Label Grid.Row="1"
                                   Text="Balance"
                                   FontSize="12"
                                   TextColor="#C7D7FE" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding BalanceDueDisplay}"
                                   FontSize="12"
                                   TextColor="#FFFFFF" />
                            <Label Grid.Row="2"
                                   Text="Change"
                                   FontSize="12"
                                   TextColor="#C7D7FE" />
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding ChangeDueDisplay}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   TextColor="#12B76A" />
                        </Grid>

                        <Button Text="{Binding ChargeText}"
                                Command="{Binding ChargeCommand}"
                                HeightRequest="54"
                                BackgroundColor="#12B76A"
                                TextColor="#FFFFFF"
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                CornerRadius="8" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Discount"
                                    Command="{Binding DiscountCommand}"
                                    BackgroundColor="#243B64"
                                    TextColor="#FFFFFF"
                                    CornerRadius="8" />
                            <Button Grid.Column="1"
                                    Text="Void"
                                    Command="{Binding VoidCommand}"
                                    BackgroundColor="#F04438"
                                    TextColor="#FFFFFF"
                                    CornerRadius="8" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </ScrollView>
    <views:SignInView />
    <views:LowStockNotificationView />
    <views:AddOnPickerView />
    </Grid>
</ContentPage>
