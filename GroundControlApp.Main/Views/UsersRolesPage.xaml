<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GroundControlApp.Main.Views.UsersRolesPage"
             x:Name="UsersPageRoot"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <Border Padding="16"
                    BackgroundColor="#14213D"
                    Stroke="#14213D"
                    StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Users and Roles"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               TextColor="#FFFFFF" />
                        <Label Text="{Binding PageStatus}"
                               FontSize="12"
                               TextColor="#C7D7FE" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Back"
                            Command="{Binding BackCommand}"
                            BackgroundColor="#FFFFFF"
                            TextColor="#14213D"
                            CornerRadius="8"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1.1*,1*" ColumnSpacing="14">
                <Border Padding="16"
                        BackgroundColor="#FFFFFF"
                        Stroke="#DDE3EA"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Employees"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="#14213D" />
                            <Button Grid.Column="1"
                                    Text="New user"
                                    Command="{Binding AddUserCommand}"
                                    BackgroundColor="#EAF8F0"
                                    TextColor="#087443"
                                    CornerRadius="8" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding UserItems}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            BackgroundColor="#F8FAFC"
                                            Stroke="#DDE3EA"
                                            StrokeShape="RoundRectangle 8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding DisplayName}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="15"
                                                       TextColor="#14213D" />
                                                <Label Text="{Binding Detail}"
                                                       FontSize="12"
                                                       TextColor="#667085" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="6"
                                                                 HorizontalOptions="End">
                                                <Label Text="{Binding RateDisplay}"
                                                       Style="{StaticResource PosPriceStyle}"
                                                       HorizontalTextAlignment="End" />
                                                <Label Text="{Binding StatusDisplay}"
                                                       FontSize="12"
                                                       TextColor="#667085"
                                                       HorizontalTextAlignment="End" />
                                                <Button Text="Edit"
                                                        Command="{Binding BindingContext.EditUserCommand, Source={x:Reference UsersPageRoot}}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#EEF4FF"
                                                        TextColor="#175CD3"
                                                        Style="{StaticResource PosSmallButtonStyle}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Padding="16"
                        BackgroundColor="#FFFFFF"
                        Stroke="#DDE3EA"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding EditorTitle}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="#14213D" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Employee number" Style="{StaticResource PosMetaStyle}" />
                                <Entry Text="{Binding EmployeeNumber}"
                                       Placeholder="EMP-1004"
                                       TextColor="#111827"
                                       PlaceholderColor="#667085"
                                       BackgroundColor="#F8FAFC" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Email" Style="{StaticResource PosMetaStyle}" />
                                <Entry Text="{Binding Email}"
                                       Placeholder="name@groundcontrol.local"
                                       Keyboard="Email"
                                       TextColor="#111827"
                                       PlaceholderColor="#667085"
                                       BackgroundColor="#F8FAFC" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="First name" Style="{StaticResource PosMetaStyle}" />
                                <Entry Text="{Binding FirstName}"
                                       Placeholder="First"
                                       TextColor="#111827"
                                       PlaceholderColor="#667085"
                                       BackgroundColor="#F8FAFC" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Last name" Style="{StaticResource PosMetaStyle}" />
                                <Entry Text="{Binding LastName}"
                                       Placeholder="Last"
                                       TextColor="#111827"
                                       PlaceholderColor="#667085"
                                       BackgroundColor="#F8FAFC" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Role" Style="{StaticResource PosMetaStyle}" />
                                <Picker ItemsSource="{Binding Roles}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedRole}"
                                        TextColor="#111827"
                                        TitleColor="#667085"
                                        BackgroundColor="#F8FAFC" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Hourly rate" Style="{StaticResource PosMetaStyle}" />
                                <Entry Text="{Binding HourlyRateText}"
                                       Keyboard="Numeric"
                                       TextColor="#111827"
                                       PlaceholderColor="#667085"
                                       BackgroundColor="#F8FAFC" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Switch IsToggled="{Binding IsActive}" />
                            <Label Grid.Column="1"
                                   Text="Active user can log in"
                                   VerticalTextAlignment="Center"
                                   TextColor="#344054" />
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="PIN for new user or overwrite" Style="{StaticResource PosMetaStyle}" />
                            <Entry Text="{Binding Pin}"
                                   IsPassword="True"
                                   Keyboard="Numeric"
                                   Placeholder="Leave blank when editing"
                                   TextColor="#111827"
                                   PlaceholderColor="#667085"
                                   BackgroundColor="#F8FAFC" />
                        </VerticalStackLayout>

                        <Button Text="Save user"
                                Command="{Binding SaveUserCommand}"
                                BackgroundColor="#14213D"
                                TextColor="#FFFFFF"
                                CornerRadius="8" />

                        <BoxView HeightRequest="1" BackgroundColor="#E4E7EC" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Reset PIN" Style="{StaticResource PosMetaStyle}" />
                            <Entry Text="{Binding ResetPin}"
                                   IsPassword="True"
                                   Keyboard="Numeric"
                                   Placeholder="New PIN"
                                   TextColor="#111827"
                                   PlaceholderColor="#667085"
                                   BackgroundColor="#F8FAFC" />
                        </VerticalStackLayout>
                        <Button Text="Reset selected user PIN"
                                Command="{Binding ResetPinCommand}"
                                BackgroundColor="#FFF6E5"
                                TextColor="#B54708"
                                CornerRadius="8" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
