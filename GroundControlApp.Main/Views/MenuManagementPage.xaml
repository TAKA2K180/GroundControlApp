<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GroundControlApp.Main.Views.MenuManagementPage"
             x:Name="MenuPage"
             BackgroundColor="#F4F6F8">

    <Grid Padding="18"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="14">
        <Border Padding="16"
                BackgroundColor="#14213D"
                Stroke="#14213D"
                StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Menu Management"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="#FFFFFF" />
                    <Label Text="{Binding PageStatus}"
                           FontSize="12"
                           TextColor="#C7D7FE" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Refresh"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="#243B64"
                        TextColor="#FFFFFF"
                        CornerRadius="8" />
                <Button Grid.Column="2"
                        Text="Back"
                        Command="{Binding BackCommand}"
                        BackgroundColor="#FFFFFF"
                        TextColor="#14213D"
                        CornerRadius="8" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="10">
            <Button Text="Add menu"
                    Command="{Binding AddMenuCommand}"
                    BackgroundColor="#EAF8F0"
                    TextColor="#087443"
                    CornerRadius="8" />
            <Button Grid.Column="1"
                    Text="Update recipe"
                    Command="{Binding UpdateRecipeCommand}"
                    BackgroundColor="#EEF4FF"
                    TextColor="#175CD3"
                    CornerRadius="8" />
            <Button Grid.Column="2"
                    Text="Set availability"
                    Command="{Binding SetAvailabilityCommand}"
                    BackgroundColor="#FFF6E5"
                    TextColor="#B54708"
                    CornerRadius="8" />
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="1.2*,0.9*"
              ColumnSpacing="14">
            <Border Padding="14"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DDE3EA"
                    StrokeShape="RoundRectangle 8">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Label Text="Menu List"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="#14213D" />

                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding MenuItems}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#DDE3EA"
                                        StrokeShape="RoundRectangle 8"
                                        MinimumHeightRequest="88">
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="5">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="17"
                                               TextColor="#14213D" />
                                        <Label Grid.Column="1"
                                               Text="{Binding PriceDisplay}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="#087443" />
                                        <Label Grid.Row="1"
                                               Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="#344054"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Grid.Row="2"
                                                               Spacing="12">
                                            <Label Text="{Binding CategoryDisplay}"
                                                   FontSize="13"
                                                   TextColor="#667085" />
                                            <Label Text="{Binding Sku}"
                                                   FontSize="13"
                                                   TextColor="#667085" />
                                            <Label Text="{Binding RecipeDisplay}"
                                                   FontSize="13"
                                                   TextColor="#667085" />
                                            <Label Text="{Binding AvailabilityDisplay}"
                                                   FontSize="13"
                                                   TextColor="#667085" />
                                        </HorizontalStackLayout>
                                        <Button Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Grid.Column="1"
                                                Text="Edit"
                                                Command="{Binding BindingContext.EditMenuCommand, Source={x:Reference MenuPage}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#EEF4FF"
                                                TextColor="#175CD3"
                                                CornerRadius="8"
                                                VerticalOptions="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="14"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DDE3EA"
                    StrokeShape="RoundRectangle 8">
                <Grid RowDefinitions="Auto,* ,Auto" RowSpacing="12">
                    <ScrollView Grid.Row="0">
                        <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding EditorTitle}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="#14213D" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="10">
                            <Entry Text="{Binding Name}"
                                   Grid.ColumnSpan="2"
                                   Placeholder="Name"
                                   BackgroundColor="#F8FAFC"
                                   TextColor="#111827" />
                            <Picker Grid.Row="1"
                                    ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategory}"
                                    ItemDisplayBinding="{Binding Name}"
                                    BackgroundColor="#FFFFFF"
                                    TextColor="#111827"
                                    TitleColor="#667085"
                                    Title="Category" />
                            <Entry Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding PriceText}"
                                   Keyboard="Numeric"
                                   Placeholder="Price"
                                   BackgroundColor="#F8FAFC"
                                   TextColor="#111827" />
                            <Editor Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Description}"
                                    Placeholder="Description"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="76"
                                    BackgroundColor="#F8FAFC"
                                    TextColor="#111827" />
                            <Label Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Sku, StringFormat='Generated SKU: {0}'}"
                                   FontSize="12"
                                   TextColor="#667085" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8">
                            <Switch IsToggled="{Binding IsAvailable}"
                                    VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Available on POS catalog"
                                   FontSize="13"
                                   TextColor="#344054"
                                   VerticalTextAlignment="Center" />
                        </Grid>

                        <Label Text="Recipe Ingredients"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="#14213D" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding Ingredients}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8"
                                      BackgroundColor="#F8FAFC"
                                      ColumnDefinitions="Auto,*,90"
                                      ColumnSpacing="8">
                                    <CheckBox IsChecked="{Binding IsIncluded}"
                                              VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="1">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13"
                                               TextColor="#14213D" />
                                        <Label Text="{Binding UnitOfMeasure}"
                                               FontSize="12"
                                               TextColor="#667085" />
                                    </VerticalStackLayout>
                                    <Entry Grid.Column="2"
                                           Text="{Binding QuantityText}"
                                           Keyboard="Numeric"
                                           Placeholder="Qty"
                                           BackgroundColor="#FFFFFF"
                                           TextColor="#111827" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Grid.Row="2"
                            Text="Save menu"
                            Command="{Binding SaveCommand}"
                            HeightRequest="50"
                            BackgroundColor="#14213D"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            CornerRadius="8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
